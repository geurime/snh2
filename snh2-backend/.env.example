# 공공데이터포털 수소충전소 API 키
HYDROGEN_API_KEY=your_api_key_here

# PostgreSQL 데이터베이스
DATABASE_URL=postgresql://user:password@localhost:5432/snh2

# Server
PORT=3000
NODE_ENV=development

# Authentication
JWT_SECRET=your_jwt_secret_here_min_32_chars
ADMIN_PASSWORD=your_admin_password_here

# Feature Flags
ENABLE_AUTH_GUARD=false
